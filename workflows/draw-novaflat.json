{
  "load": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "novaFlatXL_v90.safetensors"
    }
  },
  "clip_skip": {
    "class_type": "CLIPSetLastLayer",
    "inputs": {
      "clip": [
        "load",
        1
      ],
      "stop_at_clip_layer": -2
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip_skip",
        0
      ],
      "text": "masterpiece, best quality, amazing quality, 4k, very aesthetic, high resolution, ultra-detailed, absurdres, newest, scenery, depth of field, volumetric lighting"
    },
    "_meta": {
      "title": "正面：作者推荐词＋本次画面描述（动态传入）"
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip_skip",
        0
      ],
      "text": "modern, recent, old, oldest, cartoon, graphic, text, painting, crayon, graphite, abstract, glitch, deformed, mutated, ugly, disfigured, long body, lowres, bad anatomy, bad hands, missing fingers, extra digits, fewer digits, cropped, very displeasing, (worst quality, bad quality:1.2), sketch, jpeg artifacts, signature, watermark, username, signature, simple background, conjoined, bad ai-generated"
    },
    "_meta": {
      "title": "负面：该模型作者模板（未推荐则留空）"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "load",
        0
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "seed": 42,
      "steps": 28,
      "cfg": 5,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "load",
        2
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "qq-draw/novaflat"
    }
  }
}