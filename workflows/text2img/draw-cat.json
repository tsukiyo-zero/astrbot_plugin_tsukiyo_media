{
  "load": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "catCarrier_v90.safetensors"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "load",
        1
      ],
      "text": "masterpiece, best quality, very aesthetic, absurdres"
    },
    "_meta": {
      "title": "正面：作者推荐词＋本次画面描述（动态传入）"
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "load",
        1
      ],
      "text": "worst quality, bad quality, low quality, lowres, scan artifacts, jpeg artifacts, sketch, light particles, watermark"
    },
    "_meta": {
      "title": "负面：该模型作者模板（未推荐则留空）"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "load",
        0
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "seed": 42,
      "steps": 30,
      "cfg": 6,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "load",
        2
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "qq-draw/cat"
    }
  }
}